      "StartUri": "https://<your-function-app>.azurewebsites.net/api/login/Consumer/start",
      "ClientSecret": "@Microsoft.KeyVault(SecretUri=https://<your-key-vault>.vault.azure.net/secrets/Login--Consumer--ClientSecret/)"
    }
  },
  "Notion": {
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "ClientSecret": "@Microsoft.KeyVault(SecretUri=https://<your-key-vault>.vault.azure.net/secrets/Notion--ClientSecret/)",
    "RedirectUri": "https://<your-function-app>.azurewebsites.net/api/notion/callback",
