{
  "Signal": {
    "BaseUrl": "http://localhost:8080/",
    "PhoneNumber": "+00000000000"
  },
  "Agents": {
    "AzureOpenAiDeploymentName": "<your-deployment-name>",
    "AzureOpenAiEndpoint": "https://<your-ai-foundry-resource>.services.ai.azure.com/",
